/* Fotolivro editing desk — 4 px spacing system, Segoe UI product scale. */
* {
    font-family: "Segoe UI";
    font-size: 13px;
    color: #F1F1F3;
}

QMainWindow, QWidget#appRoot, QFrame#desk, QScrollArea#previewScroll,
QWidget#previewContent {
    background: #111215;
}

QFrame#topBar {
    background: #191A1F;
    border-bottom: 1px solid #2C2D34;
}

QFrame#workflowSidebar, QFrame#diagnosticsPanel {
    background: #191A1F;
}

QScrollArea#sidebarScroll, QWidget#sidebarContent,
QScrollArea#sidebarScroll > QWidget > QWidget {
    background: #191A1F;
    border: none;
}

QFrame#workflowSidebar {
    border-right: 1px solid #2C2D34;
}

QFrame#diagnosticsPanel {
    border-left: 1px solid #2C2D34;
}

QFrame#previewSurface {
    background: #111215;
}

QFrame#previewToolbar {
    background: #15161A;
    border-bottom: 1px solid #26272D;
}

QLabel#brandMark {
    background: #C53252;
    color: #FFFFFF;
    border-radius: 4px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 17px;
    font-weight: 700;
}

QLabel#brandName, QLabel#panelTitle {
    color: #F1F1F3;
    font-size: 15px;
    font-weight: 600;
}

QLabel#sectionTitle {
    color: #D9D9DE;
    font-size: 13px;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: #C8C8CE;
    font-size: 12px;
    font-weight: 600;
}

QLabel#mutedText, QLabel#zoomLabel {
    color: #A9AAB3;
}

QLabel#statusBanner {
    color: #B8B9C1;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 4px;
}

/* Carregando era quase a cor do painel, e passava despercebido ao lado do
   verde de sucesso e do vermelho de erro. A borda usa o rosa da marca em
   força total: distingue sem alarmar como um erro. */
QLabel#statusBanner[kind="loading"] {
    color: #FFE6EC;
    background: #3C2530;
    border-color: #C53252;
    font-weight: 600;
}

QLabel#statusBanner[kind="error"] {
    color: #FFD7DF;
    background: #3A1D25;
    border-color: #8C3146;
}

QLabel#statusBanner[kind="success"] {
    color: #CDEEDF;
    background: #192C25;
    border-color: #315C4A;
}

QLabel#statusBanner[kind="warning"] {
    color: #F4DFC1;
    background: #30271B;
    border-color: #70552D;
}

QLineEdit, QComboBox {
    min-height: 36px;
    padding: 0 10px;
    color: #F1F1F3;
    background: #202126;
    border: 1px solid #3A3B43;
    border-radius: 4px;
    selection-background-color: #C53252;
}

QLineEdit:hover, QComboBox:hover {
    border-color: #555661;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #E04C6B;
}

QLineEdit:disabled, QComboBox:disabled {
    color: #696A73;
    background: #1B1C20;
    border-color: #292A30;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
}

QComboBox QAbstractItemView {
    color: #F1F1F3;
    background: #282930;
    border: 1px solid #4A4B55;
    selection-background-color: #492531;
    outline: none;
}

QPushButton {
    min-height: 36px;
    padding: 0 12px;
    color: #F1F1F3;
    background: #282930;
    border: 1px solid #383941;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton:hover {
    background: #32333B;
    border-color: #4A4B55;
}

QPushButton:pressed {
    background: #202126;
    border-color: #D84060;
}

QPushButton:focus, QRadioButton:focus, QListWidget:focus {
    border: 2px solid #E04C6B;
}

/* A caixa de seleção ocupa a largura toda: uma borda nela desenhava um
   retângulo atravessando o diálogo. O foco marca só o quadradinho. */
QCheckBox::indicator:focus {
    border: 2px solid #E04C6B;
}

QPushButton:disabled {
    color: #696A73;
    background: #202126;
    border-color: #292A30;
}

QPushButton#primaryButton, QPushButton#importantButton {
    min-height: 44px;
    background: #C53252;
    border-color: #C53252;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#primaryButton:hover, QPushButton#importantButton:hover {
    background: #CE3657;
    border-color: #D84060;
}

QPushButton#primaryButton:pressed, QPushButton#importantButton:pressed {
    background: #BB3450;
}

QPushButton#primaryButton:disabled, QPushButton#importantButton:disabled {
    color: #9A737C;
    background: #472731;
    border-color: #472731;
}

QPushButton#squareButton {
    min-width: 36px;
    max-width: 36px;
    padding: 0;
    font-size: 17px;
}

QRadioButton {
    min-height: 36px;
    spacing: 8px;
    color: #E5E5E9;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 1px solid #62636D;
    background: #202126;
}

QRadioButton::indicator:checked {
    border: 5px solid #D84060;
    background: #F1F1F3;
}

QRadioButton:disabled {
    color: #696A73;
}

QCheckBox {
    min-height: 36px;
    spacing: 8px;
    color: #E5E5E9;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #62636D;
    border-radius: 3px;
    background: #202126;
}

QCheckBox::indicator:checked {
    background: #D84060;
    border-color: #D84060;
}

QCheckBox:disabled {
    color: #696A73;
}

QCheckBox::indicator:disabled {
    background: #1B1C20;
    border-color: #292A30;
}

QProgressBar {
    min-height: 6px;
    max-height: 6px;
    background: #2A2B31;
    border: none;
    border-radius: 3px;
}

QProgressBar::chunk {
    background: #D84060;
    border-radius: 3px;
}

QFrame#pageThumbnail {
    background: transparent;
}

QPushButton#pageReloadButton {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    color: #3E3F47;
    background: rgba(255, 255, 255, 224);
    border: 1px solid #D6D7DC;
    border-radius: 14px;
    font-family: "Segoe UI Symbol";
    font-size: 18px;
    font-weight: 600;
}

QPushButton#pageReloadButton:hover {
    color: #DA4265;
    background: #FFFFFF;
    border-color: #DA4265;
}

QPushButton#pageReloadButton:focus {
    color: #DA4265;
    background: #FFFFFF;
    border: 2px solid #DA4265;
}

QPushButton#pageReloadButton:pressed {
    color: #DA4265;
    background: #F4F4F6;
    border-color: #DA4265;
}

QPushButton#pageReloadButton:disabled {
    color: #85868E;
    background: rgba(255, 255, 255, 190);
    border-color: #D6D7DC;
}

QPushButton#pageReloadButton[busy="true"] {
    color: #696A73;
    font-size: 16px;
}

QLabel#pageImage {
    color: #9A9BA5;
    background: #202126;
    border: 1px solid #35363D;
    border-radius: 3px;
}

QLabel#pageNumber {
    color: #D7D7DC;
    font-weight: 600;
}

QLabel#pageRole {
    color: #9A9BA5;
}

QFrame#skeletonPage {
    background: #202126;
    border: 1px solid #2B2C32;
    border-radius: 3px;
}

QFrame#emptyState {
    min-width: 360px;
    max-width: 520px;
    background: transparent;
}

QLabel#emptyTitle {
    color: #F1F1F3;
    font-size: 18px;
    font-weight: 600;
}

QFrame#metricRow {
    border-bottom: 1px solid #2C2D34;
}

QLabel#metricValue {
    color: #F1F1F3;
    font-size: 18px;
    font-weight: 600;
}

QLabel#metricTextValue {
    color: #DADAE0;
    font-size: 13px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #15161A;
    width: 16px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3A3B43;
    min-height: 36px;
    border-radius: 5px;
    margin: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #50515B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

QDialog#coverDialog, QDialog#coverDialog QWidget,
QDialog#cropDialog, QDialog#cropDialog QWidget {
    background: #191A1F;
}

QWidget#cropCanvas {
    background: #111215;
    border: 1px solid #383941;
    border-radius: 4px;
}

QSlider#cropZoom {
    min-height: 36px;
}

QSlider#cropZoom::groove:horizontal {
    height: 6px;
    background: #2A2B31;
    border-radius: 3px;
}

QSlider#cropZoom::sub-page:horizontal {
    background: #D84060;
    border-radius: 3px;
}

QSlider#cropZoom::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background: #F1F1F3;
    border: 2px solid #C53252;
    border-radius: 10px;
}

QSlider#cropZoom:focus::handle:horizontal {
    border: 2px solid #E04C6B;
}

QPushButton#dialogApplyButton {
    border-color: #C53252;
    background: #492531;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#dialogApplyButton:hover {
    border-color: #E04C6B;
    background: #5A2938;
}

QListWidget {
    min-height: 160px;
    background: #111215;
    border: 1px solid #383941;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    min-height: 36px;
    padding: 0 8px;
    border-radius: 3px;
}

QListWidget::item:hover {
    background: #282930;
}

QListWidget::item:selected {
    background: #492531;
    color: #FFFFFF;
}

QToolTip {
    color: #F1F1F3;
    background: #282930;
    border: 1px solid #4A4B55;
    padding: 8px;
}

QDialog#wizardDialog, QDialog#wizardDialog QWidget {
    background: #191A1F;
}

QLabel#welcomeTitle {
    color: #F1F1F3;
    font-size: 19px;
    font-weight: 600;
}

QLabel#wizardCounter {
    color: #6E6E76;
    font-size: 11px;
    letter-spacing: 0.08em;
}

QLabel#wizardStepTitle {
    color: #F1F1F3;
    font-size: 20px;
    font-weight: 600;
}

QLabel#wizardNote {
    color: #A9AAB3;
    background: #1D1E24;
    border-left: 2px solid #C53252;
    padding: 10px 14px;
    font-size: 12px;
}

QPushButton#wizardAction {
    background: #23161B;
    border: 1px solid #47252F;
    color: #F1D9DF;
    padding: 8px 16px;
}

QPushButton#wizardAction:hover {
    background: #2E1B22;
    border-color: #C53252;
}

QPushButton#wizardAction:disabled {
    background: #1D1E24;
    border-color: #2C2D34;
    color: #55565E;
}

QFrame#welcomeFooter {
    border-top: 1px solid #2C2D34;
}

QLabel#welcomeFinePrint {
    color: #6E6E76;
    font-size: 11px;
}

QPushButton#wizardAction[ativo="true"] {
    background: #C53252;
    border-color: #C53252;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#wizardAction[ativo="true"]:hover {
    background: #D8405F;
    border-color: #D8405F;
}

QLabel#wizardBusy {
    color: #E0A34C;
    font-size: 12px;
    padding: 8px 0 0 0;
}

QProgressBar#previewBusyBar {
    background: #2A2B31;
    border: none;
    border-radius: 2px;
}

QProgressBar#previewBusyBar::chunk {
    background: #C53252;
    border-radius: 2px;
}

QLabel#previewBusyLabel {
    color: #A9AAB3;
    font-size: 12px;
}

QFrame#wizardExample {
    background: #131418;
    border-right: 1px solid #2C2D34;
}

QLabel#wizardExampleImage {
    background: transparent;
}

QWidget#wizardColumn {
    background: #191A1F;
}
